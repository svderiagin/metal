NEXT_PUBLIC_SITE_URL=http://localhost:3000

PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

NOTIFICATION_PROVIDER=
NOTIFICATION_API_KEY=
NOTIFICATION_RECIPIENT_EMAIL=

# SMTP: authenticated TLS transport (465) or STARTTLS (587). No credentials in NEXT_PUBLIC_*.
# NOTIFICATION_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Absolute private directory on a persistent volume; required in production.
# Development defaults to .local/orders. Not suitable for an ephemeral/serverless filesystem.
ORDER_STORAGE_DIR=

# Preview has red placeholders for bank account and VAT and cannot be paid.
# Switch to live only after confirming bank account, VAT rate and included pricing.
INVOICE_MODE=preview
INVOICE_BANK_ACCOUNT=
# NONE, 5, 7, 10 or 22. Do not assume a rate from a template.
INVOICE_VAT_RATE=
INVOICE_PRICES_INCLUDE_VAT=true
INVOICE_PAYMENT_DAYS=3
