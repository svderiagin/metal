{
  "name": "metal-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/catalog-image-versions.mjs --dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prebuild": "node scripts/catalog-image-versions.mjs && npm run images:prepare",
    "images:prepare": "node --import tsx scripts/prepare-photos.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "libphonenumber-js": "1.13.16",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "pdf-lib": "^1.17.1",
    "postgres": "4.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5"
  },
  "overrides": {
    "minimatch@<4": "$minimatch",
    "minimatch@>=4 <11.0.1": "11.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "minimatch": "file:./tools/minimatch-legacy",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
